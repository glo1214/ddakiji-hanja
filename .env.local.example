# Firebase 웹 앱 설정 (Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성)
# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요. (.env.local 은 git에 올리지 않음)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 설명하기 채점·분석 LLM 키 (OpenAI GPT, 서버 전용 — NEXT_PUBLIC_ 아님, 클라이언트에 노출 안 됨).
# 비워두면 /api/autotag 가 503을 반환하고 규칙 기반 태깅으로 자동 폴백한다.
OPENAI_API_KEY=
# 채점에 사용할 모델. 비워두면 gpt-5.4-mini 를 기본값으로 사용한다.
OPENAI_MODEL=gpt-5.4-mini
